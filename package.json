{
  "name": "tour",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tour - dynamic banner showcase with an admin panel, backed by Supabase Storage.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "hash-password": "node scripts/hash-password.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/storage-js": "^2.109.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "vite": "^8.3.5"
  }
}
