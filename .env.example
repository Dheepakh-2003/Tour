# --- Supabase (server-side only; never prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=tour-storage

# --- Admin authentication ---
# Simple option: the admin password as plain text (takes priority if set)
ADMIN_PASSWORD=
# Safer option: leave ADMIN_PASSWORD empty and use a hash.
# Generate with:  npm run hash-password -- "your-admin-password"
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters (the hash-password script prints one)
SESSION_SECRET=

# --- App ---
# Public URL of the app. Local: http://localhost:5173  Production: https://your-app.vercel.app
APP_URL=http://localhost:5173
# Local Express port (ignored on Vercel)
PORT=5000
